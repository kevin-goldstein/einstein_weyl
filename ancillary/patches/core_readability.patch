+struct QuadInterval {
+  __float128 lo, hi;
+  QuadInterval() : lo(0), hi(0) {
+  }
+  QuadInterval(int x) : lo(x), hi(x) {
+  }
+  QuadInterval(long x) : lo(x), hi(x) {
+  }
+  QuadInterval(__float128 x) : lo(x), hi(x) {
+  }
+  QuadInterval(const char *s) {
+    lo = strtoflt128(s, nullptr);
+    hi = lo;
+  }
+  QuadInterval(__float128 l, __float128 h, bool) : lo(l), hi(h) {
+  }
+};
+static __float128 qdn(__float128 x) {
+  return nextafterq(x, -HUGE_VALQ);
+}
+static __float128 qup(__float128 x) {
+  return nextafterq(x, HUGE_VALQ);
+}
+static QuadInterval operator+(QuadInterval a, QuadInterval b) {
+  return QuadInterval(qdn(a.lo + b.lo), qup(a.hi + b.hi), true);
+}
+static QuadInterval operator-(QuadInterval a, QuadInterval b) {
+  return QuadInterval(qdn(a.lo - b.hi), qup(a.hi - b.lo), true);
+}
+static QuadInterval operator-(QuadInterval a) {
+  return QuadInterval(qdn(-a.hi), qup(-a.lo), true);
+}
+static QuadInterval operator*(QuadInterval a, QuadInterval b) {
+  __float128 p[4] = {a.lo * b.lo, a.lo * b.hi, a.hi * b.lo, a.hi * b.hi};
+  __float128 l = p[0], h = p[0];
+  for (int i = 1; i < 4; i++) {
+    l = fminq(l, p[i]);
+    h = fmaxq(h, p[i]);
+  }
+  return QuadInterval(qdn(l), qup(h), true);
+}
+static QuadInterval operator/(QuadInterval a, QuadInterval b) {
+  if (b.lo <= 0 && b.hi >= 0)
+    throw std::runtime_error("qzero");
+  QuadInterval r(qdn(1 / b.hi), qup(1 / b.lo), true);
+  return a * r;
+}
+static QuadInterval &operator+=(QuadInterval &a, QuadInterval b) {
+  a = a + b;
+  return a;
+}
+static QuadInterval &operator*=(QuadInterval &a, QuadInterval b) {
+  a = a * b;
+  return a;
+}
+static __float128 qmag(QuadInterval a) {
+  return fmaxq(fabsq(a.lo), fabsq(a.hi));
+}
+static QuadInterval qsym(__float128 a) {
+  return QuadInterval(qdn(-a), qup(a), true);
+}
+static QuadInterval qfrom(const I &a) {
+  return QuadInterval(
+      mpfr_get_float128(a.lo.x, MPFR_RNDD), mpfr_get_float128(a.hi.x, MPFR_RNDU), true);
