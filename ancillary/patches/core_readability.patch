+// Center-state interval arithmetic.
+// Appendix C labels: eq:core-picard-inclusion, eq:core-order56-step.
+static I mpfr_hull(const I &a, const I &b) {
+  Real l = a.lo;
+  if (lt(b.lo, l))
+    l = b.lo;
+  Real h = a.hi;
+  if (lt(h, b.hi))
+    h = b.hi;
+  return I(l, h);
+}
+static I mpfr_inflate(const I &a,
+                      const std::string &rels = "1.01",
+                      const std::string &abss = "1e-100") {
+  Real m = mid(a), w = width(a), rad = rdiv(w, Real(2), MPFR_RNDU), rel(rels), ab(abss);
+  rad = rmul(rad, rel, MPFR_RNDU);
+  rad = radd(rad, ab, MPFR_RNDU);
+  return I(rsub(m, rad, MPFR_RNDD), radd(m, rad, MPFR_RNDU));
+}
+static bool strict_mpfr_subset(const I &a, const I &b) {
+  return lt(b.lo, a.lo) && lt(a.hi, b.hi);
+}
+static I mpfr_forward_range_product(const I &f, const I &h) {
+  return I(Real(0), h.hi) * f;
+}
+// Six-state vector field, in the order (A,p,C,d,Y,J).
+// Main equations eq:F and eq:first-order-rest; Appendix C uses this
+// same expression for state, Jacobian and Hessian calculations.
+template <class T> std::array<T, 6> core_rhs(const std::array<T, 6> &y, const T &t) {
+  const T &A = y[0], &p = y[1], &C = y[2], &d = y[3], &Y = y[4], &J = y[5];
+  T F = T(2) * p * p / A + A * Y / (T(6) * (t + C)) + A * d / (T(3) * t * (t + C)) -
+        p * d / (t + C) - C * p / (t * (t + C)) - T(2) * p / (t + C);
+  return {p, F, d, Y, J, T(6) * t * F / (A * A * A)};
+}
+template <int K>
+static I
+mpfr_convolution(const std::array<I, K + 1> &a, const std::array<I, K + 1> &b, int n) {
+  I s(0);
+  for (int i = 0; i <= n; i++)
+    s += a[i] * b[n - i];
+  return s;
+}
+template <int K> struct MpfrStateTaylor {
+  std::array<std::array<I, K + 1>, 6> x;
+};
+// Taylor coefficients obtained directly from the ODE recurrence.
+// Appendix C: eq:core-order56-step.
+template <int K>
+static MpfrStateTaylor<K> mpfr_state_taylor_coefficients(const std::array<I, 6> &x0,
+                                                         const I &t0) {
+  MpfrStateTaylor<K> o;
+  for (int j = 0; j < 6; j++) {
+    for (int n = 0; n <= K; n++)
+      o.x[j][n] = I(0);
+    o.x[j][0] = x0[j];
+  }
+  auto &A = o.x[0];
+  auto &p = o.x[1];
+  auto &C = o.x[2];
+  auto &d = o.x[3];
+  auto &Y = o.x[4];
+  auto &J = o.x[5];
+  std::array<I, K + 1> tt{}, D{}, iA{}, iD{}, it{}, p2{}, p2iA{}, AY{}, AYiD{}, Ad{},
+      itiD{}, AditiD{}, pd{}, pdiD{}, Cp{}, CpitiD{}, piD{}, F{}, tF{}, iA2{}, iA3{},
+      tFiA3{};
+  tt[0] = t0;
+  if (K >= 1)
+    tt[1] = I(1);
+  for (int n = 0; n < K; n++) {
+    D[n] = tt[n] + C[n];
+    if (n == 0) {
+      iA[0] = I(1) / A[0];
+      iD[0] = I(1) / D[0];
+      it[0] = I(1) / tt[0];
+    } else {
+      I sa(0), sd(0), st(0);
+      for (int i = 1; i <= n; i++) {
+        sa += A[i] * iA[n - i];
+        sd += D[i] * iD[n - i];
+        st += tt[i] * it[n - i];
+      }
+      iA[n] = -sa / A[0];
+      iD[n] = -sd / D[0];
+      it[n] = -st / tt[0];
+    }
+    p2[n] = mpfr_convolution<K>(p, p, n);
+    p2iA[n] = mpfr_convolution<K>(p2, iA, n);
+    AY[n] = mpfr_convolution<K>(A, Y, n);
+    AYiD[n] = mpfr_convolution<K>(AY, iD, n);
+    Ad[n] = mpfr_convolution<K>(A, d, n);
+    itiD[n] = mpfr_convolution<K>(it, iD, n);
+    AditiD[n] = mpfr_convolution<K>(Ad, itiD, n);
+    pd[n] = mpfr_convolution<K>(p, d, n);
+    pdiD[n] = mpfr_convolution<K>(pd, iD, n);
+    Cp[n] = mpfr_convolution<K>(C, p, n);
+    CpitiD[n] = mpfr_convolution<K>(Cp, itiD, n);
+    piD[n] = mpfr_convolution<K>(p, iD, n);
+    F[n] = I(2) * p2iA[n] + AYiD[n] / I(6) + AditiD[n] / I(3) - pdiD[n] - CpitiD[n] -
+           I(2) * piD[n];
+    tF[n] = mpfr_convolution<K>(tt, F, n);
+    iA2[n] = mpfr_convolution<K>(iA, iA, n);
+    iA3[n] = mpfr_convolution<K>(iA2, iA, n);
+    tFiA3[n] = mpfr_convolution<K>(tF, iA3, n);
+    I den(n + 1);
+    A[n + 1] = p[n] / den;
+    p[n + 1] = F[n] / den;
+    C[n + 1] = d[n] / den;
+    d[n + 1] = Y[n] / den;
+    Y[n + 1] = J[n] / den;
+    J[n + 1] = I(6) * tFiA3[n] / den;
+  }
+  return o;
+}
+// Strict Picard tube, followed by the order-56 Lagrange-remainder step.
+// Appendix C: eq:core-picard-inclusion, eq:core-order56-step.
+template <int K>
+static bool validated_center_step(std::array<I, 6> &X,
+                                  I &t,
+                                  const I &h,
+                                  std::array<I, 6> &tube,
+                                  MpfrStateTaylor<K> &c,
+                                  MpfrStateTaylor<K> &rb) {
+  I T(t.lo, radd(t.hi, h.hi, MPFR_RNDU));
+  auto f0 = core_rhs<I>(X, t);
+  std::array<I, 6> Z;
+  for (int i = 0; i < 6; i++)
+    Z[i] = mpfr_inflate(
+        mpfr_hull(X[i], X[i] + mpfr_forward_range_product(f0[i], h)), "2", "1e-90");
+  bool ok = false;
+  for (int itn = 0; itn < 30; itn++) {
+    auto f = core_rhs<I>(Z, T);
+    bool all = true;
+    std::array<I, 6> Zn;
+    for (int i = 0; i < 6; i++) {
+      I P = mpfr_hull(X[i], X[i] + mpfr_forward_range_product(f[i], h));
+      if (!strict_mpfr_subset(P, Z[i]))
+        all = false;
+      Zn[i] = mpfr_inflate(mpfr_hull(Z[i], P), "1.02", "1e-90");
+    }
+    if (all) {
+      ok = true;
+      break;
+    }
+    Z = Zn;
+  }
+  if (!ok)
+    return false;
+  c = mpfr_state_taylor_coefficients<K>(X, t);
+  rb = mpfr_state_taylor_coefficients<K>(Z, T);
+  I hp(1);
+  for (int n = 0; n < K; n++)
+    hp *= h;
+  for (int i = 0; i < 6; i++) {
+    I s = c.x[i][K - 1];
+    for (int n = K - 2; n >= 0; n--)
+      s = s * h + c.x[i][n];
+    s += rb.x[i][K] * hp;
+    X[i] = s;
+  }
+  tube = Z;
+  t = t + h;
+  return true;
+}
 
